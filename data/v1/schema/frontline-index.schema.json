{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://russianlosses.mario-jemic.workers.dev/data/v1/schema/frontline-index.schema.json",
  "title": "Frontline snapshot index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset",
    "generated_at",
    "coverage_start",
    "coverage_end",
    "record_count",
    "sources",
    "methodology",
    "license_notice",
    "snapshots",
    "latest"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "dataset": { "const": "frontline_snapshots" },
    "generated_at": { "type": "string", "format": "date-time" },
    "coverage_start": { "type": "string", "format": "date" },
    "coverage_end": { "type": "string", "format": "date" },
    "record_count": { "type": "integer", "minimum": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "methodology": { "type": "string", "minLength": 1 },
    "license_notice": { "type": "string", "minLength": 1 },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/snapshot" }
    },
    "latest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "url"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "url": { "type": "string", "pattern": "^/" }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "role"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "phase", "url"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "phase": {
          "enum": ["pre_invasion_baseline", "full_scale_war"]
        },
        "occupied_km2": { "type": "number", "minimum": 0 },
        "url": { "type": "string", "pattern": "^/" }
      }
    }
  }
}
