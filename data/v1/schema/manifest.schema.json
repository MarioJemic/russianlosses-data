{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://russianlosses.mario-jemic.workers.dev/data/v1/schema/manifest.schema.json",
  "title": "Russian Losses public data manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "schema_version",
    "generated_at",
    "publisher",
    "license_notice",
    "attribution",
    "datasets",
    "schemas"
  ],
  "properties": {
    "api_version": { "const": "v1" },
    "schema_version": { "enum": ["1.0.0", "1.1.0"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "website", "repository"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "website": { "type": "string", "format": "uri" },
        "repository": { "type": "string", "format": "uri" }
      }
    },
    "license_notice": { "type": "string", "minLength": 1 },
    "attribution": { "type": "string", "minLength": 1 },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dataset" }
    },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/schema_file" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "role"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^/data/v1/" },
        "media_type": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "schema_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "media_type", "bytes", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^/data/v1/schema/" },
        "media_type": { "const": "application/schema+json" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "coverage_start",
        "coverage_end",
        "record_count",
        "schema",
        "sources",
        "files"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "category": { "enum": ["losses", "territory", "social", "economy", "fires"] },
        "catalog_group": { "enum": ["primary", "additional"] },
        "generated_at": { "type": "string", "format": "date-time" },
        "last_observation": { "type": ["string", "null"], "pattern": "^\\d{4}(-\\d{2}-\\d{2})?$" },
        "temporal_resolution": { "enum": ["date", "year", "month", "mixed"] },
        "time_basis": { "enum": ["reference_year", "edition_year"] },
        "coverage_start": { "type": "string", "format": "date" },
        "coverage_end": { "type": "string", "format": "date" },
        "record_count": { "type": "integer", "minimum": 1 },
        "schema": { "type": "string", "pattern": "^/data/v1/schema/" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/file" }
        }
      }
    }
  }
}
