{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://russianlosses.mario-jemic.workers.dev/data/v1/schema/fire-weekly-record.schema.json",
  "title": "Weekly satellite fire estimate record",
  "description": "One GWIS weekly fire estimate and historical same-week baseline for a country.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "country_iso3",
    "country",
    "year",
    "week",
    "observation_status",
    "fires",
    "burnt_area_ha",
    "historical_average_fires",
    "historical_average_burnt_area_ha",
    "source_url"
  ],
  "properties": {
    "date": { "type": "string", "format": "date" },
    "country_iso3": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "country": { "type": "string", "minLength": 1 },
    "year": { "type": "integer", "minimum": 2000, "maximum": 2100 },
    "week": { "type": "integer", "minimum": 1, "maximum": 53 },
    "observation_status": { "const": "weekly_estimate" },
    "fires": { "type": "number", "minimum": 0 },
    "burnt_area_ha": { "type": "number", "minimum": 0 },
    "historical_average_fires": { "type": "number", "minimum": 0 },
    "historical_average_burnt_area_ha": { "type": "number", "minimum": 0 },
    "source_url": { "type": "string", "format": "uri" }
  }
}
